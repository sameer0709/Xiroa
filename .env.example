# ===== Xiroa ERP — Environment Variables (copy to .env and fill in) =====
# NEVER commit the real .env file. This is only a template.

# ---- Database (PostgreSQL) ----
# For local dev you can keep H2 (default). For production, use PostgreSQL:
#   Free PostgreSQL: https://neon.tech  or  https://supabase.com
DB_URL=jdbc:postgresql://localhost:5432/xiroadb
DB_USERNAME=xiroa
DB_PASSWORD=change-this-password

# ---- Security ----
# REQUIRED before selling. Generate with:  openssl rand -base64 48
XIROA_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# ---- AI (optional) ----
# Set to "openai" to enable LLM-powered insights (requires OPENAI_API_KEY)
AI_PROVIDER=rule-based
OPENAI_API_KEY=

# ---- Docker compose only ----
POSTGRES_PASSWORD=change-this-password

